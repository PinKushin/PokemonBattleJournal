###############################################################################
# Line endings: LF everywhere.
#
# LF is git's native storage format, matches the Ubuntu runners the Android CI
# uses, and matches what essentially every file-writing tool emits by default —
# so there is nothing to convert and git never prints a normalization warning.
# Visual Studio, MSBuild and PowerShell all read LF without complaint.
#
# Only add an eol=crlf entry below for files that genuinely BREAK with LF.
###############################################################################
* text=auto eol=lf

# Correctness overrides — not style. Batch files require CRLF to execute; the
# repo has none today, but the guard keeps a future one from silently breaking.
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Binary — never normalize
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.db3      binary
*.ttf      binary
*.otf      binary
*.apk      binary
*.snk      binary

###############################################################################
# Set default behavior to automatically normalize line endings.
# CRLF on checkout (Windows), LF in repo.
###############################################################################
* text=auto eol=crlf

# Explicit text rules
*.cs       text eol=crlf
*.xaml     text eol=crlf
*.csproj   text eol=crlf
*.slnx     text eol=crlf
*.yml      text eol=crlf
*.yaml     text eol=crlf
*.json     text eol=crlf
*.jsonc    text eol=crlf
*.md       text eol=crlf
*.xml      text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.ps1      text eol=crlf
*.css      text eol=crlf
*.js       text eol=crlf
*.ts       text eol=crlf
*.svg      text eol=crlf
*.txt      text eol=crlf

# Shell scripts need LF to run on Linux CI
*.sh       text eol=lf

# Binary — never normalize
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.db3      binary
*.ttf      binary
*.otf      binary


<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PokemonBattleJournal.AppShell"
    x:Name="TheShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PokemonBattleJournal.Models"
    xmlns:views="clr-namespace:PokemonBattleJournal.Views"
    xmlns:vm="clr-namespace:PokemonBattleJournal.ViewModels"
    Title="Pokemon TCG Battle Journal"
    Shell.FlyoutBehavior="Flyout">
    <Shell.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Shell.Resources>
    <Shell.FlyoutContent>
        <ScrollView BindingContext="{Binding Source={x:Reference TheShell}, Path=BindingContext}">
            <VerticalStackLayout Spacing="0">

                <!--  Switch Trainer accordion — top of list  -->
                <Border Padding="20,14" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleTrainerMenuCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            FontFamily="SairaRegular"
                            FontSize="15"
                            Text="Switch Trainer"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontFamily="SairaRegular"
                            FontSize="13"
                            Text="▶"
                            TextColor="{StaticResource PokeYellow}"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsTrainerMenuOpen}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="Text" Value="▼" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </Border>
                <VerticalStackLayout IsVisible="{Binding IsTrainerMenuOpen}" Spacing="0">
                    <CollectionView ItemsSource="{Binding Trainers}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Trainer">
                                <Border Padding="40,12,20,12" BackgroundColor="Transparent" StrokeThickness="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference TheShell}, Path=BindingContext.SelectTrainerCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        FontFamily="SairaRegular"
                                        FontSize="14"
                                        Text="{Binding Name}"
                                        TextColor="{StaticResource PokeYellow}" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!--  Separator  -->
                <BoxView
                    Margin="20,4"
                    BackgroundColor="{StaticResource PokeBlue}"
                    HeightRequest="1"
                    HorizontalOptions="Fill" />

                <!--  Nav items  -->
                <Border Padding="20,14" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//MainPage" />
                    </Border.GestureRecognizers>
                    <Label FontFamily="SairaRegular" FontSize="15" Text="Journal Entry" />
                </Border>
                <Border Padding="20,14" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//ReadJournalPage" />
                    </Border.GestureRecognizers>
                    <Label FontFamily="SairaRegular" FontSize="15" Text="Read Journal" />
                </Border>
                <Border Padding="20,14" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//TrainerPage" />
                    </Border.GestureRecognizers>
                    <Label FontFamily="SairaRegular" FontSize="15" Text="Trainer's Profile" />
                </Border>
                <Border Padding="20,14" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//OptionsPage" />
                    </Border.GestureRecognizers>
                    <Label FontFamily="SairaRegular" FontSize="15" Text="Options" />
                </Border>
                <Border Padding="20,14" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//AboutPage" />
                    </Border.GestureRecognizers>
                    <Label FontFamily="SairaRegular" FontSize="15" Text="About" />
                </Border>


            </VerticalStackLayout>
        </ScrollView>
    </Shell.FlyoutContent>
    <Shell.FlyoutHeader>

        <Grid BackgroundColor="{StaticResource PokeBlue}" HeightRequest="{OnIdiom Phone=55, Default=100}">
            <Image
                Aspect="AspectFill"
                Opacity="0.2"
                Source="ball_icon.png" />
            <Label
                FontFamily="PokemonSolid"
                FontSize="Large"
                HorizontalTextAlignment="Center"
                Text="PTCG Journal"
                VerticalTextAlignment="Center" />
        </Grid>

    </Shell.FlyoutHeader>
    <ShellContent
        Title="Journal Entry"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Read Journal"
        ContentTemplate="{DataTemplate views:ReadJournalPage}"
        Route="ReadJournalPage" />
    <ShellContent
        Title="Trainer's Profile"
        ContentTemplate="{DataTemplate views:TrainerPage}"
        Route="TrainerPage" />
    <ShellContent
        Title="Options"
        ContentTemplate="{DataTemplate views:OptionsPage}"
        Route="OptionsPage" />
    <ShellContent
        Title="About"
        ContentTemplate="{DataTemplate views:AboutPage}"
        Route="AboutPage" />
    <Shell.FlyoutFooter>
        <Grid BackgroundColor="{StaticResource PokeBlue}" HeightRequest="50">
            <!--  Footer content, typically used for copyright or additional links  -->
            <Label
                FontSize="Small"
                HorizontalTextAlignment="Center"
                Text="© The Unlicense"
                TextColor="{StaticResource PokeYellow}"
                VerticalTextAlignment="Center" />
        </Grid>
    </Shell.FlyoutFooter>
</Shell>

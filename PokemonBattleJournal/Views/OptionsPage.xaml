<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PokemonBattleJournal.Views.OptionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PokemonBattleJournal.Controls"
    xmlns:loading="clr-namespace:PokemonBattleJournal.Controls.Loading"
    xmlns:models="clr-namespace:PokemonBattleJournal.Models;assembly=PokemonBattleJournal.Core"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:restore="clr-namespace:PokemonBattleJournal.Services.Restore;assembly=PokemonBattleJournal.Core"
    xmlns:viewmodel="clr-namespace:PokemonBattleJournal.ViewModels"
    x:Name="BasePage"
    Title="{Binding Title}"
    x:DataType="viewmodel:OptionsPageViewModel"
    AutomationId="OptionsPage">
    <Shell.TitleView>
        <Label AutomationId="OptionsTitleBar" SemanticProperties.Description="Options page title" Style="{StaticResource ShellTitleLabel}" Text="{Binding Title}" />
    </Shell.TitleView>
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference BasePage}, x:DataType=ContentPage}"
            Command="{Binding AppearingCommand}"
            EventName="Appearing" />
    </ContentPage.Behaviors>
    <Grid>
        <!--  Loading-gate sentinels, OUTSIDE the scrolling content on purpose.

              These are 1×1 markers that UI tests poll to know when an operation has finished.
              As children of the content stack they were layout participants, so un-hiding one
              added its 1px plus the stack's 12px Spacing and pushed the whole page down 13px —
              measured, not guessed. Every element below then had two possible positions
              depending on whether an operation happened to be in flight, which on Android can
              put a row above the scroll position where UiScrollable cannot reach it (it only
              scrolls down).

              As direct Grid children they overlap the content in the same cell and pin to the
              top-left at 1×1 with no text, so they are invisible, cost no space, and still
              appear in the automation tree by AutomationId.  -->
        <Label
            AutomationId="Busy_ArchetypeList"
            HeightRequest="1"
            HorizontalOptions="Start"
            IsVisible="{Binding IsBusyArchetypeList}"
            VerticalOptions="Start"
            WidthRequest="1" />
        <Label
            AutomationId="Busy_Mutating"
            HeightRequest="1"
            HorizontalOptions="Start"
            IsVisible="{Binding IsBusyMutating}"
            VerticalOptions="Start"
            WidthRequest="1" />

        <ScrollView AutomationId="OptionsScrollView">
            <VerticalStackLayout
                Padding="20"
                HorizontalOptions="Center"
                MaximumWidthRequest="480"
                Spacing="12">

                <!--  DEBUG only: holds the busy gate open so the spinner can be seen and tested.
                      Bound to IsDebugBuild so it is absent from Release builds.  -->
                <Button
                    x:Name="SimulateLoadingButton"
                    AutomationId="SimulateLoadingButton"
                    SemanticProperties.Description="Toggle simulated loading"
                    SemanticProperties.Hint="Debug only. Holds the loading indicator on screen until pressed again"
                    Command="{Binding ToggleSimulatedLoadingCommand}"
                    HorizontalOptions="Center"
                    IsVisible="{x:Static viewmodel:OptionsPageViewModel.IsDebugBuild}"
                    Text="Toggle loading indicator"
                    WidthRequest="220" />

                <!--  DEBUG only: sends one trace and one error so the Sentry pipeline can be
                      confirmed end to end. "Configured" and "arriving" are different claims —
                      TracesSampleRate was set for months while nothing reached the dashboard,
                      and no test could catch it because tests never initialise the SDK.  -->
                <Button
                    x:Name="SentryDiagnosticsButton"
                    AutomationId="SentryDiagnosticsButton"
                    SemanticProperties.Description="Send Sentry test event"
                    SemanticProperties.Hint="Debug only. Sends one trace and one deliberate error to Sentry"
                    Command="{Binding SendSentryDiagnosticsCommand}"
                    HorizontalOptions="Center"
                    IsVisible="{x:Static viewmodel:OptionsPageViewModel.IsDebugBuild}"
                    Text="Send Sentry test event"
                    WidthRequest="220" />

                <!--  Trainer section  -->
                <Label AutomationId="TrainerSectionHeading" SemanticProperties.HeadingLevel="Level2" Style="{StaticResource Headline}" Text="Trainer" />

                <Border
                    Padding="12,8"
                    Stroke="{StaticResource PokeYellow}"
                    StrokeThickness="1.5">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource FieldLabel}" Text="Trainer Name" />
                        <Entry
                            x:Name="TrainerNameInput"
                            AutomationId="TrainerNameInput"
                            SemanticProperties.Description="Trainer name"
                            SemanticProperties.Hint="Enter the trainer name to save under"
                            FontFamily="SairaRegular"
                            Placeholder="Enter New Trainer Name"
                            Text="{Binding NameInput}" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    x:Name="SaveTrainerNameButton"
                    AutomationId="SaveTrainerNameButton"
                            SemanticProperties.Description="Save trainer name"
                    Command="{Binding SaveTrainerCommand}"
                    HorizontalOptions="Center"
                    Text="Create New Trainer"
                    WidthRequest="220" />

                <!--  Archetype section  -->
                <Label AutomationId="ArchetypeSectionHeading" SemanticProperties.HeadingLevel="Level2" Style="{StaticResource Headline}" Margin="0,8,0,0" Text="Custom Archetype" />

                <Border
                    Padding="12,8"
                    Stroke="{StaticResource PokeYellow}"
                    StrokeThickness="1.5">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="Archetype Icon" />
                        <controls:ComboBoxControl
                            x:Name="NewArchetypeIcon"
                            ActivatorAutomationId="ArchetypeIconPicker"
                            SemanticProperties.Description="Archetype icon"
                            SemanticProperties.Hint="Pick an icon for the new archetype"
                            Style="{StaticResource ArchetypePicker}"
                            DisplayMemberPath="Name"
                            ImageMemberPath="ImagePath"
                            ItemsSource="{Binding IconItems}"
                            Placeholder="Select Icon"
                            SelectedItem="{Binding SelectedIconItem}" />
                        <Label
                            FontFamily="SairaRegular"
                            FontSize="10"
                            Text="Select the icon for your custom archetype"
                            TextColor="{StaticResource Gray400}" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="12,8"
                    Stroke="{StaticResource PokeYellow}"
                    StrokeThickness="1.5">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource FieldLabel}" Text="Archetype Name" />
                        <Entry
                            x:Name="ArchetypeNameInput"
                            AutomationId="ArchetypeNameInput"
                            SemanticProperties.Description="Archetype name"
                            SemanticProperties.Hint="Enter a name for the new archetype"
                            FontFamily="SairaRegular"
                            Placeholder="Enter New Archetype's Name"
                            Text="{Binding NewDeckName}" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    x:Name="SaveArchetypeButton"
                    AutomationId="SaveArchetypeButton"
                            SemanticProperties.Description="Save archetype"
                    Command="{Binding SaveArchetypeCommand}"
                    HorizontalOptions="Center"
                    Text="Save Archetype"
                    WidthRequest="220" />

                <VerticalStackLayout
                    AutomationId="ArchetypeList"
                    SemanticProperties.Description="Saved archetypes"
                    BindableLayout.ItemsSource="{Binding AllArchetypes}"
                    Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Archetype">
                            <Grid
                                AutomationId="{Binding Name, StringFormat='ArchetypeItem_{0}'}"
                                Padding="4,2"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    HeightRequest="24"
                                    WidthRequest="24"
                                    Source="{Binding ImagePath}" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="SairaRegular"
                                    FontSize="13"
                                    Text="{Binding Name}"
                                    VerticalOptions="Center" />
                                <Button
                                    Grid.Column="2"
                                    AutomationId="{Binding Name, StringFormat='DeleteArchetype_{0}'}"
                                    SemanticProperties.Description="{Binding Name, StringFormat='Delete {0} archetype'}"
                                    BackgroundColor="{StaticResource BostonRed}"
                                    Command="{Binding Source={x:Reference BasePage}, Path=BindingContext.DeleteArchetypeCommand}"
                                    CommandParameter="{Binding .}"
                                    FontSize="11"
                                    HeightRequest="28"
                                    Padding="8,0"
                                    Text="Delete"
                                    TextColor="{StaticResource White}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!--  Tags section  -->
                <Label AutomationId="TagSectionHeading" SemanticProperties.HeadingLevel="Level2" Style="{StaticResource Headline}" Margin="0,8,0,0" Text="Custom Tag" />

                <Border
                    Padding="12,8"
                    Stroke="{StaticResource PokeYellow}"
                    StrokeThickness="1.5">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource FieldLabel}" Text="Tag Name" />
                        <Entry
                            x:Name="TagInput"
                            AutomationId="TagInput"
                            SemanticProperties.Description="Tag name"
                            SemanticProperties.Hint="Enter a name for the new tag"
                            FontFamily="SairaRegular"
                            Placeholder="Enter New Tag"
                            Text="{Binding TagInput}" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    x:Name="SaveTagButton"
                    AutomationId="SaveTagButton"
                            SemanticProperties.Description="Save tag"
                    Command="{Binding SaveTagCommand}"
                    HorizontalOptions="Center"
                    Text="Save New Tag"
                    WidthRequest="220" />

                <VerticalStackLayout
                    AutomationId="TagList"
                    SemanticProperties.Description="Saved tags"
                    BindableLayout.ItemsSource="{Binding AllTags}"
                    Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Tags">
                            <Grid
                                AutomationId="{Binding Name, StringFormat='TagItem_{0}'}"
                                Padding="4,2"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="SairaRegular"
                                    FontSize="13"
                                    Text="{Binding Name}"
                                    VerticalOptions="Center" />
                                <Button
                                    Grid.Column="1"
                                    AutomationId="{Binding Name, StringFormat='DeleteTag_{0}'}"
                                    SemanticProperties.Description="{Binding Name, StringFormat='Delete {0} tag'}"
                                    BackgroundColor="{StaticResource BostonRed}"
                                    Command="{Binding Source={x:Reference BasePage}, Path=BindingContext.DeleteTagCommand}"
                                    CommandParameter="{Binding .}"
                                    FontSize="11"
                                    HeightRequest="28"
                                    Padding="8,0"
                                    Text="Delete"
                                    TextColor="{StaticResource White}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!--  Import  -->
                <Label AutomationId="ImportSectionHeading" SemanticProperties.HeadingLevel="Level2" Style="{StaticResource Headline}" Margin="0,8,0,0" Text="Import" />

                <Button
                    x:Name="ImportTrainerHillButton"
                    AutomationId="ImportTrainerHillButton"
                    SemanticProperties.Description="Import matches from TrainerHill"
                    SemanticProperties.Hint="Opens file picker to select a TrainerHill battle log JSON file"
                    Command="{Binding ImportFromTrainerHillCommand}"
                    HorizontalOptions="Center"
                    Text="Import from TrainerHill"
                    WidthRequest="220" />

                <Label
                    AutomationId="ImportStatusLabel"
                    SemanticProperties.Description="Import status"
                    FontFamily="SairaRegular"
                    FontSize="12"
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasImportStatus}"
                    Text="{Binding ImportStatusMessage}"
                    TextColor="{StaticResource PokeYellow}" />

                <!--  Export  -->
                <Label AutomationId="ExportSectionHeading" SemanticProperties.HeadingLevel="Level2" Style="{StaticResource Headline}" Margin="0,8,0,0" Text="Export" />

                <Button
                    x:Name="ExportTrainerHillButton"
                    AutomationId="ExportTrainerHillButton"
                    SemanticProperties.Description="Export this trainer's matches in TrainerHill format"
                    SemanticProperties.Hint="Opens a save dialog to write a TrainerHill battle log JSON file"
                    Command="{Binding ExportTrainerHillCommand}"
                    HorizontalOptions="Center"
                    Text="Export to TrainerHill"
                    WidthRequest="220" />

                <Button
                    x:Name="ExportBackupButton"
                    AutomationId="ExportBackupButton"
                    SemanticProperties.Description="Export a full backup of every trainer"
                    SemanticProperties.Hint="Opens a save dialog to write a backup JSON file containing all trainers"
                    Command="{Binding ExportBackupCommand}"
                    HorizontalOptions="Center"
                    Text="Export backup (all trainers)"
                    WidthRequest="220" />

                <Label
                    AutomationId="ExportStatusLabel"
                    SemanticProperties.Description="Export status"
                    FontFamily="SairaRegular"
                    FontSize="12"
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasExportStatus}"
                    Text="{Binding ExportStatusMessage}"
                    TextColor="{StaticResource PokeYellow}" />

                <!--  Restore  -->
                <Label AutomationId="RestoreSectionHeading" SemanticProperties.HeadingLevel="Level2" Style="{StaticResource Headline}" Margin="0,8,0,0" Text="Restore" />

                <Button
                    x:Name="RestoreBackupButton"
                    AutomationId="RestoreBackupButton"
                    SemanticProperties.Description="Restore trainers and matches from a backup file"
                    SemanticProperties.Hint="Opens file picker to select a backup JSON file. Matches already present are kept, not replaced"
                    Command="{Binding RestoreBackupCommand}"
                    HorizontalOptions="Center"
                    Text="Restore from backup"
                    WidthRequest="220" />

                <Label
                    AutomationId="RestoreStatusLabel"
                    SemanticProperties.Description="Restore status"
                    FontFamily="SairaRegular"
                    FontSize="12"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding HasRestoreStatus}"
                    Text="{Binding RestoreStatusMessage}"
                    TextColor="{StaticResource PokeYellow}" />

                <!--  DEBUG only: the review section is invisible until a conflict exists, and
                      producing a real one needs an export, an edit and a restore through a file
                      picker Appium cannot drive. Same arrangement as the loading toggle.  -->
                <Button
                    x:Name="SeedConflictsButton"
                    AutomationId="SeedConflictsButton"
                    SemanticProperties.Description="Seed sample conflicts"
                    SemanticProperties.Hint="Debug only. Fills the review list with two example conflicts"
                    Command="{Binding SeedSampleConflictsCommand}"
                    HorizontalOptions="Center"
                    IsVisible="{x:Static viewmodel:OptionsPageViewModel.IsDebugBuild}"
                    Text="Seed sample conflicts"
                    WidthRequest="220" />

                <!--  Conflicts left by the last restore  -->
                <!--
                    Hidden entirely when there is nothing outstanding, so the page does not carry
                    an empty panel around. Everything here is staged: choosing writes nothing, and
                    only Apply reaches the database.
                -->
                <VerticalStackLayout IsVisible="{Binding HasConflicts}" Spacing="8">

                    <Label
                        AutomationId="ConflictSectionHeading"
                        SemanticProperties.HeadingLevel="Level2"
                        Style="{StaticResource Headline}"
                        Margin="0,8,0,0"
                        Text="Needs review" />

                    <Label
                        AutomationId="ConflictHelpLabel"
                        SemanticProperties.Description="What the review choices mean"
                        FontFamily="SairaRegular"
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        Text="These matches differ from the backup. Nothing is saved until you press Apply."
                        TextColor="{StaticResource PokeYellow}" />

                    <!--
                        ONE match at a time, walked like a rebase - not a list of every conflict.

                        The list version put the three choice buttons inside a DataTemplate, so
                        they were virtualised: realised, recycled and re-realised as rows moved.
                        That is what produced the CI race where ApplyConflictsButton sat in the
                        UIA tree advertising no invokable pattern and the click guard reported it
                        as off-window. A single card built once and re-bound has no such window.

                        It also bounds the panel. The match count is whatever the backup carried;
                        the games INSIDE one match are capped at three by BO3, which is why those
                        still stack via BindableLayout below.
                    -->
                    <Label
                        AutomationId="ConflictPositionLabel"
                        SemanticProperties.Description="Which match you are reviewing"
                        FontFamily="SairaBold"
                        FontSize="12"
                        HorizontalOptions="Center"
                        Text="{Binding ConflictPositionLabel}"
                        TextColor="{StaticResource PokeBlue}" />

                    <Border
                        Margin="0,4"
                        Padding="10"
                        Stroke="{StaticResource PokeBlue}"
                        StrokeThickness="1">
                        <!--
                            x:DataType re-anchors compiled bindings here. The page root declares
                            OptionsPageViewModel, and unlike a DataTemplate this element does not
                            reset the ambient type when its BindingContext changes — without this,
                            every binding below compiles against the PAGE view model and fails
                            silently at runtime: blank labels, and buttons whose UIA Invoke lands
                            while their command never fires.
                        -->
                        <VerticalStackLayout
                            x:DataType="viewmodel:ConflictRowViewModel"
                            BindingContext="{Binding CurrentConflict, x:DataType=viewmodel:OptionsPageViewModel}"
                            Spacing="6">

                            <Label
                                AutomationId="ConflictTitleLabel"
                                FontFamily="SairaBold"
                                FontSize="13"
                                Text="{Binding Title}"
                                TextColor="{StaticResource PokeYellow}" />

                            <Label
                                FontFamily="SairaRegular"
                                FontSize="11"
                                Text="{Binding Description}" />

                            <!--
                                One block per differing game. BindableLayout rather than a nested
                                CollectionView: a CollectionView inside a CollectionView
                                virtualises independently and its rows leave the accessibility
                                tree when scrolled, which is what made ReadJournal's tag lists
                                unreachable - see project_readjournal_android_slow.
                            -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Games}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:ConflictGameRowViewModel">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontFamily="SairaBold"
                                                FontSize="11"
                                                Text="{Binding Label}"
                                                TextColor="{StaticResource PokeBlue}" />
                                            <Label
                                                FontFamily="SairaRegular"
                                                FontSize="11"
                                                IsVisible="{Binding HasPresenceDifference}"
                                                Text="{Binding PresenceSummary}" />
                                            <Label
                                                FontFamily="SairaRegular"
                                                FontSize="11"
                                                IsVisible="{Binding HasTagDifference}"
                                                Text="{Binding AddedTagSummary}" />
                                            <Label
                                                FontFamily="SairaRegular"
                                                FontSize="11"
                                                IsVisible="{Binding HasTagDifference}"
                                                Text="{Binding RemovedTagSummary}" />
                                            <VerticalStackLayout
                                                BindableLayout.ItemsSource="{Binding NoteDiffLines}"
                                                IsVisible="{Binding HasNoteDifference}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="restore:NoteDiffLine">
                                                        <Label
                                                            FontFamily="SairaRegular"
                                                            FontSize="11"
                                                            Text="{Binding Text}" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!--
                                Three real Buttons, not a styled Border with a gesture. A Border
                                exposes no UIA pattern, so a screen reader can announce it and
                                never activate it - see feedback_invokable_controls.
                            -->
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                <Button
                                    AutomationId="ConflictKeepButton"
                                    SemanticProperties.Description="Keep the version already in the app"
                                    Command="{Binding ChooseKeepCommand}"
                                    FontSize="11"
                                    Text="Keep mine"
                                    WidthRequest="100" />
                                <Button
                                    AutomationId="ConflictAppendButton"
                                    SemanticProperties.Description="Keep both versions, joined together"
                                    Command="{Binding ChooseAppendCommand}"
                                    FontSize="11"
                                    Text="Keep both"
                                    WidthRequest="100" />
                                <Button
                                    AutomationId="ConflictReplaceButton"
                                    SemanticProperties.Description="Replace with the version from the backup"
                                    Command="{Binding ChooseReplaceCommand}"
                                    FontSize="11"
                                    Text="Use backup"
                                    WidthRequest="100" />
                            </HorizontalStackLayout>

                            <Label
                                AutomationId="ConflictChoiceLabel"
                                SemanticProperties.Description="Your choice for this match"
                                FontFamily="SairaRegular"
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="{Binding ChoiceSummary}"
                                TextColor="{StaticResource PokeYellow}" />

                        </VerticalStackLayout>
                    </Border>

                    <!--
                        Prev/Next are always present and disabled at the ends rather than hidden.
                        A control that vanishes shifts everything below it, and that layout shift
                        is the same class of problem the inline loading indicator had.
                    -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Button
                            AutomationId="PreviousConflictButton"
                            SemanticProperties.Description="Go back to the previous match"
                            Command="{Binding PreviousConflictCommand}"
                            FontSize="11"
                            IsEnabled="{Binding HasPreviousConflict}"
                            Text="Previous"
                            WidthRequest="100" />
                        <Button
                            AutomationId="NextConflictButton"
                            SemanticProperties.Description="Go to the next match"
                            Command="{Binding NextConflictCommand}"
                            FontSize="11"
                            IsEnabled="{Binding HasNextConflict}"
                            Text="Next"
                            WidthRequest="100" />
                    </HorizontalStackLayout>

                    <Button
                        x:Name="ApplyConflictsButton"
                        AutomationId="ApplyConflictsButton"
                        SemanticProperties.Description="Apply the choices you have made"
                        SemanticProperties.Hint="Writes only the matches you answered. Anything left blank stays listed"
                        Command="{Binding ApplyConflictsCommand}"
                        HorizontalOptions="Center"
                        Text="Apply choices"
                        WidthRequest="220" />

                </VerticalStackLayout>

                <!--  Save all / danger zone  -->
                <BoxView
                    Margin="0,8"
                    BackgroundColor="{StaticResource PokeBlue}"
                    HeightRequest="1"
                    HorizontalOptions="Fill" />

                <Button
                    x:Name="SaveAllButton"
                    AutomationId="SaveAllButton"
                            SemanticProperties.Description="Save all options"
                    Command="{Binding SaveAllCommand}"
                    HorizontalOptions="Center"
                    Text="Save All"
                    WidthRequest="220" />

                <Button
                    x:Name="DeleteTrainer"
                    AutomationId="DeleteTrainer"
                            SemanticProperties.Description="Delete trainer"
                            SemanticProperties.Hint="Permanently removes this trainer and their matches"
                    BackgroundColor="{StaticResource BostonRed}"
                    Command="{Binding DeleteTrainerFileCommand}"
                    HorizontalOptions="Center"
                    Text="Delete Current Trainer"
                    TextColor="{StaticResource White}"
                    WidthRequest="220" />

                <!--#region Trainer Switcher-->
                <Label AutomationId="SwitchTrainerHeading" SemanticProperties.HeadingLevel="Level2" Style="{StaticResource Headline}" Margin="0,8,0,0" Text="Switch Trainer" />

                <Border
                    Padding="12,8"
                    Stroke="{StaticResource PokeYellow}"
                    StrokeThickness="1.5">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource FieldLabel}" Text="Active Trainer" />
                        <Picker
                            AutomationId="TrainerSwitchPicker"
                            SemanticProperties.Description="Switch trainer"
                            SemanticProperties.Hint="Choose which trainer profile is active"
                            FontFamily="SairaRegular"
                            ItemDisplayBinding="{Binding Name}"
                            ItemsSource="{Binding AllTrainers}"
                            SelectedItem="{Binding SelectedSwitchTrainer, Mode=TwoWay}" />
                    </VerticalStackLayout>
                </Border>

                <!--#endregion-->

            </VerticalStackLayout>
        </ScrollView>

        <!--  Loading indicator, drawn OVER the page rather than in it.

              It is a sibling of the ScrollView in the same Grid cell, so it occupies no
              layout space and nothing below it moves when it appears. As an inline child it
              pushed ~144px of content down every time it showed, which gave every element
              below two possible positions depending on timing.

              InputTransparent passes clicks through to the content underneath. Layout
              cascades this to children by default, so the spinner and its label are
              transparent too. It matters because the indicator deliberately lingers 500ms
              after the busy gate clears, so a user (or a UI test) is interacting with the
              page again while it is still on screen.

              IsVisible follows the control's own IsShowing rather than the raw busy flag, so
              that minimum-visible-duration is what decides when the host disappears —
              otherwise fast work would flash.  -->
        <VerticalStackLayout
            x:Name="LoadingIndicatorHost"
            AutomationId="LoadingIndicatorHost"
            SemanticProperties.Description="Loading"
            HorizontalOptions="Center"
            InputTransparent="True"
            IsVisible="{Binding Source={x:Reference PageLoadingIndicator}, Path=IsShowing, x:DataType=loading:LoadingIndicator}"
            Spacing="4"
            VerticalOptions="Center">
            <loading:LoadingIndicator
                x:Name="PageLoadingIndicator"
                AutomationId="PageLoadingIndicator"
                ArcColor="{StaticResource BostonRed}"
                HeightRequest="96"
                IsBusy="{Binding IsAnyBusy}"
                WidthRequest="96" />
            <Label
                AutomationId="LoadingIndicatorLabel"
                FontFamily="SairaRegular"
                FontSize="12"
                HorizontalOptions="Center"
                Text="Working…"
                TextColor="{StaticResource PokeYellow}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PokemonBattleJournal.Views.TrainerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PokemonBattleJournal.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodel="clr-namespace:PokemonBattleJournal.ViewModels"
    x:Name="BasePage"
    Title="{Binding WelcomeMsg}"
    x:DataType="viewmodel:TrainerPageViewModel">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference BasePage}, x:DataType=ContentPage}"
            Command="{Binding AppearingCommand}"
            EventName="Appearing" />
    </ContentPage.Behaviors>

    <ScrollView>
        <StackLayout Padding="10">
            <Label
                AutomationId="TrainerWelcomeLabel"
                FontSize="24"
                HorizontalOptions="Center"
                Text="{Binding WelcomeMsg}" />

            <!-- Stats Summary -->
            <Label
                FontSize="18"
                Text="Win Rate:" />
            <Label
                AutomationId="WinRateLabel"
                FontSize="18"
                Text="{Binding WinAverage, StringFormat='{0:F2}%'}" />
            <Label
                FontSize="18"
                Text="Wins:" />
            <Label
                FontSize="18"
                Text="{Binding Wins}" />
            <Label
                FontSize="18"
                Text="Losses:" />
            <Label
                FontSize="18"
                Text="{Binding Losses}" />
            <Label
                FontSize="18"
                Text="Ties:" />
            <Label
                FontSize="18"
                Text="{Binding Ties}" />

            <!-- Most Played Archetypes -->
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Margin="0,10,0,5"
                Text="Most Played Archetypes" />
            <CollectionView
                ItemsSource="{Binding MostPlayedArchetypes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="models:ChartDataPoint">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="5">
                            <Label
                                FontSize="16"
                                Text="{Binding Label}" />
                            <Label
                                Grid.Column="1"
                                FontSize="16"
                                Text="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Win Rate Over Time -->
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Margin="0,10,0,5"
                Text="Win Rate Over Time" />
            <CollectionView
                ItemsSource="{Binding WinRateOverTime}">
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="models:TimeDataPoint">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="5">
                            <Label
                                FontSize="14"
                                Text="{Binding Date, StringFormat='{0:MM/dd}'}" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="{Binding Value, StringFormat='{0:F1}%'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Archetype Win Rates -->
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Margin="0,10,0,5"
                Text="Archetype Win Rates" />
            <CollectionView
                ItemsSource="{Binding ArchetypeWinRates}">
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="models:ChartDataPoint">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="5">
                            <Label
                                FontSize="14"
                                Text="{Binding Label}" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="{Binding Value, StringFormat='{0:F1}%'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Tag Usage -->
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Margin="0,10,0,5"
                Text="Tag Usage" />
            <CollectionView
                ItemsSource="{Binding TagUsage}">
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="models:ChartDataPoint">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="5">
                            <Label
                                FontSize="14"
                                Text="{Binding Label}" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Performance vs Opponents -->
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Margin="0,10,0,5"
                Text="Performance vs Opponents" />
            <CollectionView
                ItemsSource="{Binding OpponentPerformance}">
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="models:ChartDataPoint">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="5">
                            <Label
                                FontSize="14"
                                Text="{Binding Label}" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="{Binding Value, StringFormat='{0:F1}%'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Win Rate by Match Length -->
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Margin="0,10,0,5"
                Text="Win Rate by Match Length" />
            <CollectionView
                ItemsSource="{Binding WinRateByMatchLength}">
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="models:ChartDataPoint">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="5">
                            <Label
                                FontSize="14"
                                Text="{Binding Label}" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="{Binding Value, StringFormat='{0:F1}%'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- First Turn Advantage -->
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Margin="0,10,0,5"
                Text="First Turn Advantage" />
            <CollectionView
                ItemsSource="{Binding FirstTurnAdvantage}">
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="models:ChartDataPoint">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="5">
                            <Label
                                FontSize="14"
                                Text="{Binding Label}" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="{Binding Value, StringFormat='{0:F1}%'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Additional Stats -->
            <StackLayout Padding="10,20">
                <Label
                    FontSize="20"
                    Text="Additional Statistics" />
                <Label
                    Text="{Binding AverageMatchDuration, StringFormat='Average Match Duration: {0:hh\\:mm\\:ss}'}" />
                <Label
                    Text="{Binding StreakInfo}" />
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>

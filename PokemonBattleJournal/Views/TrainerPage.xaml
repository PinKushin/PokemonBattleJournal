<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PokemonBattleJournal.Views.TrainerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:viewmodel="clr-namespace:PokemonBattleJournal.ViewModels"
    x:Name="BasePage"
    Title="{Binding WelcomeMsg}"
    x:DataType="viewmodel:TrainerPageViewModel">
    <Shell.TitleView>
        <Label Style="{StaticResource ShellTitleLabel}" Text="{Binding WelcomeMsg}" />
    </Shell.TitleView>
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference BasePage}, x:DataType=ContentPage}"
            Command="{Binding AppearingCommand}"
            EventName="Appearing" />
    </ContentPage.Behaviors>

    <ScrollView>
        <StackLayout Padding="16" Spacing="8">

            <Grid ColumnDefinitions="*,*,*,*" Margin="0,8,0,4">
                <StackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Style="{StaticResource StatName}" Text="Win Rate" />
                    <Label AutomationId="WinRateLabel" Style="{StaticResource StatValue}" Text="{Binding WinAverage, StringFormat='{0:F1}%'}" />
                </StackLayout>
                <StackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Style="{StaticResource StatName}" Text="Wins" />
                    <Label AutomationId="WinsLabel" SemanticProperties.Description="Total wins" Style="{StaticResource StatValue}" Text="{Binding Wins}" />
                </StackLayout>
                <StackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Style="{StaticResource StatName}" Text="Losses" />
                    <Label AutomationId="LossesLabel" SemanticProperties.Description="Total losses" Style="{StaticResource StatValue}" Text="{Binding Losses}" />
                </StackLayout>
                <StackLayout Grid.Column="3" HorizontalOptions="Center">
                    <Label Style="{StaticResource StatName}" Text="Ties" />
                    <Label AutomationId="TiesLabel" SemanticProperties.Description="Total ties" Style="{StaticResource StatValue}" Text="{Binding Ties}" />
                </StackLayout>
            </Grid>

            <Label AutomationId="AverageMatchDurationLabel" Text="{Binding AverageMatchDuration, StringFormat='Avg Match: {0:mm\\:ss}'}" HorizontalOptions="Center" FontSize="13" />
            <Label AutomationId="StreakInfoLabel" Text="{Binding StreakInfo}" HorizontalOptions="Center" FontSize="13" />

            <BoxView HeightRequest="1" Color="{StaticResource PokeYellow}" Opacity="0.3" Margin="0,8,0,8" />
            <Label Style="{StaticResource ChartSectionHeader}" Text="Matchup Matrix" />
            <lvc:CartesianChart
                AutomationId="MatchupMatrixChart"
                SemanticProperties.Description="Matchup matrix chart showing win rate against each opponent archetype"
                Series="{Binding MatchupHeatSeries}"
                XAxes="{Binding MatchupXAxes}"
                YAxes="{Binding MatchupYAxes}"
                HeightRequest="220"
                Margin="0,0,0,8" />

            <BoxView HeightRequest="1" Color="{StaticResource PokeYellow}" Opacity="0.3" Margin="0,4,0,8" />
            <Label Style="{StaticResource ChartSectionHeader}" Text="Win Rate Over Time" />
            <lvc:CartesianChart
                AutomationId="WinRateOverTimeChart"
                SemanticProperties.Description="Line chart of win rate over time"
                Series="{Binding WinRateOverTimeSeries}"
                XAxes="{Binding WinRateTimeXAxes}"
                HeightRequest="220"
                Margin="0,0,0,8" />

            <BoxView HeightRequest="1" Color="{StaticResource PokeYellow}" Opacity="0.3" Margin="0,4,0,8" />
            <Label Style="{StaticResource ChartSectionHeader}" Text="Most Played Archetypes" />
            <lvc:CartesianChart
                AutomationId="MostPlayedChart"
                SemanticProperties.Description="Bar chart of most played archetypes"
                Series="{Binding MostPlayedSeries}"
                YAxes="{Binding MostPlayedYAxes}"
                HeightRequest="200"
                Margin="0,0,0,8" />

            <BoxView HeightRequest="1" Color="{StaticResource PokeYellow}" Opacity="0.3" Margin="0,4,0,8" />
            <Label Style="{StaticResource ChartSectionHeader}" Text="Win Rate by Archetype" />
            <lvc:CartesianChart
                AutomationId="ArchetypeWinRateChart"
                SemanticProperties.Description="Bar chart of win rate by archetype played"
                Series="{Binding ArchetypeWinRateSeries}"
                YAxes="{Binding ArchetypeWinRateYAxes}"
                HeightRequest="200"
                Margin="0,0,0,8" />

            <BoxView HeightRequest="1" Color="{StaticResource PokeYellow}" Opacity="0.3" Margin="0,4,0,8" />
            <Label Style="{StaticResource ChartSectionHeader}" Text="Performance vs Opponents" />
            <lvc:CartesianChart
                AutomationId="OpponentPerformanceChart"
                SemanticProperties.Description="Bar chart of performance against opponent archetypes"
                Series="{Binding OpponentSeries}"
                YAxes="{Binding OpponentYAxes}"
                HeightRequest="200"
                Margin="0,0,0,8" />

            <BoxView HeightRequest="1" Color="{StaticResource PokeYellow}" Opacity="0.3" Margin="0,4,0,8" />
            <Label Style="{StaticResource ChartSectionHeader}" Text="Tag Usage" />
            <lvc:CartesianChart
                AutomationId="TagUsageChart"
                SemanticProperties.Description="Bar chart of how often each tag is used"
                Series="{Binding TagUsageSeries}"
                YAxes="{Binding TagUsageYAxes}"
                HeightRequest="200"
                Margin="0,0,0,8" />

            <BoxView HeightRequest="1" Color="{StaticResource PokeYellow}" Opacity="0.3" Margin="0,4,0,8" />
            <Label Style="{StaticResource ChartSectionHeader}" Text="Win Rate by Match Length" />
            <lvc:CartesianChart
                AutomationId="MatchLengthChart"
                SemanticProperties.Description="Bar chart of win rate by match length"
                Series="{Binding MatchLengthSeries}"
                YAxes="{Binding MatchLengthYAxes}"
                HeightRequest="200"
                Margin="0,0,0,8" />

            <BoxView HeightRequest="1" Color="{StaticResource PokeYellow}" Opacity="0.3" Margin="0,4,0,8" />
            <Label Style="{StaticResource ChartSectionHeader}" Text="First Turn Advantage" />
            <lvc:CartesianChart
                AutomationId="FirstTurnChart"
                SemanticProperties.Description="Bar chart of win rate when going first versus second"
                Series="{Binding FirstTurnSeries}"
                YAxes="{Binding FirstTurnYAxes}"
                HeightRequest="200"
                Margin="0,0,0,8" />

        </StackLayout>
    </ScrollView>
</ContentPage>

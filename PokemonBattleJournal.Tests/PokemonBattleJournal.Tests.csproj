<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <UseMaui>true</UseMaui>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeCoverage" Version="18.8.1" />
        <PackageReference Include="Microsoft.Maui.Core" Version="10.0.90" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="NSubstitute" Version="6.0.0" />
        <PackageReference Include="NSubstitute.Analyzers.CSharp" Version="1.0.17">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageReference Include="Shouldly" Version="4.3.0" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.21" />

        <!--
            SkiaSharp's native library, for Linux only.

            LiveChartsCore.SkiaSharpView.Maui carries natives for the MAUI platforms, so on
            Windows this is already satisfied and the reference would be dead weight — hence
            the condition. Linux was never a test environment until the measurement box, and
            CI runs every test job on windows-latest, so nothing here had ever executed on
            Linux before 2026-08-10.

            Without it, AppearingAsync_WithMatchupData_SetsMatchupHeatSeries dies in
            SKTypeface's static constructor with DllNotFoundException for libSkiaSharp. That
            matters beyond one red test: Stryker does an initial full test run and a failing
            suite makes every subsequent mutant result meaningless.

            NativeAssets.Linux, not .NoDependencies — the failing path is SKTypeface, i.e.
            fonts, so fontconfig is genuinely needed rather than avoidable.
        -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0"
                          Condition="$([MSBuild]::IsOSPlatform('linux'))" />
        <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.90" />

    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PokemonBattleJournal\PokemonBattleJournal.csproj" />
        <ProjectReference Include="..\PokemonBattleJournal.Core\PokemonBattleJournal.Core.csproj" />
    <ProjectReference Include="..\PokemonBattleJournal.Scraper\PokemonBattleJournal.Scraper.csproj" />
    </ItemGroup>



    <ItemGroup>
        <PackageReference Update="Microsoft.Maui.Controls" Version="10.0.90" />
    </ItemGroup>

</Project>
